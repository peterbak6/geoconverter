{
  "name": "@peterbak6/geoconverter",
  "version": "1.0.2",
  "license": "MIT",
  "description": "A numerically stable, auditable coordinate conversion library optimized for high-throughput workloads.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts-resolve",
    "postbuild": "node ../../scripts/clean-dts.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('tests wired later')\""
  },
  "keywords": [
    "itm",
    "epsg2039",
    "israel",
    "israeli-transverse-mercator",
    "transverse-mercator",
    "coordinate-conversion",
    "geodesy",
    "gis",
    "proj4",
    "mapping"
  ],
  "homepage": "https://peterbak6.github.io/geoconverter/",
  "repository": {
    "type": "git",
    "url": "https://github.com/peterbak6/geoconverter"
  },
  "bugs": {
    "url": "https://github.com/peterbak6/geoconverter/issues"
  }
}
